# Idler Configuration
IDLER_ENV=development
IDLER_HOST=127.0.0.1
IDLER_PORT=8000

# Local AI / Ollama Configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma2:2b
IDLER_USE_MOCK_MODEL=false

# Persistence
DATABASE_URL=sqlite:///./idler.db

# Workspace Directories (Comma-separated list of approved absolute workspace paths)
# Example: /Users/username/Desktop/Idler/test_workspace
IDLER_ALLOWED_WORKSPACES=./test_workspace

